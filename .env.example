# Server-side only. Never exposed to the browser.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id used for the single cross-check + narrative call.
# Free tier covers Flash / Flash-Lite only (Pro is behind billing).
# "-latest" aliases reduce the risk of a hard failure when a dated model retires.
GEMINI_MODEL=gemini-flash-latest

# Model used for the opt-in scanned-PDF vision fallback.
GEMINI_VISION_MODEL=gemini-flash-latest

# Optional: restrict which sites may iframe this tool.
# Defaults to "*". Example: "https://yoursite.com https://www.yoursite.com"
ALLOWED_FRAME_ANCESTORS=
