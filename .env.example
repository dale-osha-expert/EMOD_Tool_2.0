# Server-side only. Never exposed to the browser.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model for the single cross-check + narrative call.
#
# Pin an explicit stable version rather than a "-latest" alias. An alias is
# hot-swapped on every release and may point at a preview or experimental
# model, so it changes behaviour silently. A pinned model that retires returns
# 404, which this tool reports by name ("the configured AI model X is not
# available") while every calculation keeps working - a loud failure you can
# act on, instead of a quiet drift you cannot detect.
#
# Free tier covers Flash and Flash-Lite; Pro is behind billing.
# Confirm the current ids against the model list in AI Studio.
GEMINI_MODEL=gemini-3.6-flash

# Model for the opt-in scanned-PDF transcription. Flash-Lite is optimised for
# document parsing, and keeping it separate means transcribing a scan does not
# consume the narrative call's per-minute quota, since limits are per-model.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Avoid gemini-2.5-flash and gemini-2.5-flash-lite: both shut down 2026-10-16.

# Optional: restrict which sites may iframe this tool.
# Read at build time, so changing it requires a redeploy.
# Defaults to "*". Example: "https://yoursite.com https://www.yoursite.com"
ALLOWED_FRAME_ANCESTORS=
